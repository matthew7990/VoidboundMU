<Window x:Class="MuVoidLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MuVoidLauncher"
        mc:Ignorable="d"
        Title="MuVoid Launcher" Height="450" Width="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- Main Background with Rounded Corners -->
        <Border CornerRadius="15" ClipToBounds="True">
            <Grid>
                <!-- Background Image Layer (Placeholder for now with gradient) -->
                <Rectangle x:Name="BackgroundRect">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1a1c2c" Offset="0"/>
                            <GradientStop Color="#0f0f1a" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Cinematic Overlay -->
                <Rectangle Opacity="0.4">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="1" RadiusY="1">
                            <GradientStop Color="Transparent" Offset="0.5"/>
                            <GradientStop Color="Black" Offset="1.5"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- UI Content Area -->
                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Center/News info -->
                        <RowDefinition Height="Auto"/> <!-- Bottom/Progress -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="MU" Foreground="White" FontSize="36" FontWeight="Bold" FontFamily="Segoe UI Black"/>
                        <TextBlock Text="VOID" Foreground="#8a2be2" FontSize="36" FontWeight="Bold" FontFamily="Segoe UI Black">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="15" Color="#8a2be2" Opacity="0.6" ShadowDepth="0"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <!-- Control Buttons (Custom Minimize/Close) -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="−" Background="Transparent" Foreground="Gray" BorderThickness="0" Width="30" Height="30" FontSize="20" Click="Minimize_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                        <Button Content="✕" Background="Transparent" Foreground="Gray" BorderThickness="0" Width="30" Height="30" FontSize="16" Click="Close_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                    </StackPanel>

                    <!-- News/Status Box (Glassmorphism Effect) -->
                    <Border Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Width="300" Height="150" 
                            Background="#1AFFFFFF" CornerRadius="10" BorderBrush="#33FFFFFF" BorderThickness="1">
                        <StackPanel Margin="15">
                            <TextBlock x:Name="VersionText" Text="VERSION 0.99b" Foreground="#AAFFFFFF" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="Voidbound Update" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/>
                            <TextBlock x:Name="ChangelogText" Text="Classic gameplay with modern infrastructure. Prepare for the battlefield." 
                                       Foreground="#CCFFFFFF" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Bottom Section -->
                    <StackPanel Grid.Row="2" Margin="0,20,0,0">
                        <Grid>
                            <TextBlock x:Name="StatusLabel" Text="Checking for updates..." Foreground="#AAFFFFFF" FontSize="14" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="ProgressLabel" Text="0%" Foreground="#AAFFFFFF" FontSize="14" HorizontalAlignment="Right"/>
                        </Grid>
                        
                        <!-- Progress Bar -->
                        <Grid Height="8" Margin="0,5,0,20">
                            <Rectangle Fill="#22FFFFFF" RadiusX="4" RadiusY="4"/>
                            <Rectangle x:Name="ProgressBarFill" Fill="#8a2be2" Width="0" HorizontalAlignment="Left" RadiusX="4" RadiusY="4">
                                <Rectangle.Effect>
                                    <DropShadowEffect BlurRadius="10" Color="#8a2be2" Opacity="0.5" ShadowDepth="0"/>
                                </Rectangle.Effect>
                            </Rectangle>
                        </Grid>

                        <!-- Main Action Button -->
                        <Button x:Name="PlayButton" Content="PLAY" Height="50" Width="200" HorizontalAlignment="Right" 
                                FontSize="20" FontWeight="Bold" Cursor="Hand" Click="PlayButton_Click" IsEnabled="False">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#8a2be2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="25">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#a142ff"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#33FFFFFF"/>
                                                        <Setter Property="Foreground" Value="#55FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
